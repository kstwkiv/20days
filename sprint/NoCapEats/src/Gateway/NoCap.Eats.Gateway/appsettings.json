{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Ocelot": "Warning"
      }
    }
  },
  "Jwt": {
    "Secret": "CHANGE_ME_use_a_32+_char_secret_key_in_production",
    "Issuer": "NoCap.Eats.Identity",
    "Audience": "NoCap.Eats.Clients"
  },
  "SwaggerEndPoints": [
    {
      "Key": "identity",
      "Config": [
        {
          "Name": "Identity API",
          "Version": "v1",
          "Url": "http://localhost:5200/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "catalog",
      "Config": [
        {
          "Name": "Catalog API",
          "Version": "v1",
          "Url": "http://localhost:5201/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "order",
      "Config": [
        {
          "Name": "Order API",
          "Version": "v1",
          "Url": "http://localhost:5202/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "delivery",
      "Config": [
        {
          "Name": "Delivery API",
          "Version": "v1",
          "Url": "http://localhost:5203/swagger/v1/swagger.json"
        }
      ]
    }
  ],
  "AllowedHosts": "*"
}
